# ==============================================================================
# RuleForge Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Azure AI Foundry / Azure OpenAI (Primary)
# ------------------------------------------------------------------------------
# Endpoint URL from Azure AI Foundry (Model Inference API or Azure OpenAI):
# Examples:
#   Model Inference: https://<your-resource-name>.services.ai.azure.com/models
#   Serverless Model: https://<model-endpoint>.<region>.models.ai.azure.com
#   Azure OpenAI:     https://<your-resource-name>.openai.azure.com
AZURE_AI_ENDPOINT=https://your-resource-name.services.ai.azure.com/models

# Your Azure AI Foundry or Azure OpenAI API Key:
AZURE_AI_API_KEY=your_azure_ai_api_key_here

# The model name or deployment name deployed in Azure:
# Examples: gpt-4o, gpt-4o-mini, Meta-Llama-3.1-70B-Instruct, Mistral-large
AZURE_AI_MODEL=gpt-4o

# (Optional) API Version for Azure OpenAI deployments (defaults to 2024-06-01)
AZURE_AI_API_VERSION=2024-06-01

# ------------------------------------------------------------------------------
# Execution Ceilings & Settings (Optional)
# ------------------------------------------------------------------------------
# Maximum output tokens requested per compilation round (default: 16000)
QUERY_MAX_TOKENS=16000

# Per-request timeout in milliseconds (default: 1800000 = 30 minutes)
# CHAT_TIMEOUT_MS=1800000

# Number of retry attempts on transient network or rate-limit errors (default: 4)
# CHAT_RETRIES=4

# ------------------------------------------------------------------------------
# Fallback Providers (Optional)
# ------------------------------------------------------------------------------
# If not using Azure AI Foundry, you can specify OpenRouter or OpenAI keys:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
